{
  "extends": "../tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx", "../cypress.config.ts"],
  "exclude": [],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "ES2022"],
    "types": ["cypress", "node"],
    "ignoreDeprecations": "6.0",
    "isolatedModules": false,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  }

}
